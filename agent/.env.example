# Copy to .env for local runs. GitHub Actions reads these from repo secrets.

# OpenRouter (https://openrouter.ai/keys) — used as a fallback for
# writer/editor/planner if Gemini is unavailable.
OPENROUTER_API_KEY=

# Google AI Studio (https://aistudio.google.com/apikey) — used for
# planner, writer, editor, and image generation (free tier).
GEMINI_API_KEY=

# Reddit app (https://www.reddit.com/prefs/apps, type "script") — used
# by the reddit source to read subreddit "hot" listings via OAuth.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# YouTube Data API v3 key (https://console.cloud.google.com/apis) — used
# by the youtube source to read official channel uploads.
YOUTUBE_API_KEY=
