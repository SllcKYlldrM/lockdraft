---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<MainGridLayout title={title} description={description}>
	<article class="card-base rounded-(--radius-large) px-6 py-8 md:px-10 md:py-10">
		<div class="prose prose-lg dark:prose-invert max-w-none">
			<h1>{title}</h1>
			<p class="text-sm opacity-70">Last updated: September 25, 2026</p>
			<slot />
		</div>
	</article>
</MainGridLayout>
